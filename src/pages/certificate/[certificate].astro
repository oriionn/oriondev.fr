---
import CertifLayout from "../../layouts/CertifLayout.astro";

import type { GetStaticPaths } from 'astro';
// @ts-expect-error
import { readdirSync } from "fs";

export const prerender = true;

export const getStaticPaths = (async () => {
    let certificates = readdirSync("public/certificates").map((certificate: string) =>
        certificate.split(".").slice(0, -1).join("."),
    );

    return certificates.map((c: string) => ({ params: {
        certificate: c
    }}));
}) satisfies GetStaticPaths;

const { certificate } = Astro.params;
---

<CertifLayout>
    <canvas id="certificate" class={`/certificates/${certificate}.pdf`}></canvas>
</CertifLayout>

<style>
    #certificate {
        margin-top: 90px;
        border-radius: 10px;
    }

    #certificate {
        width: 100%;
        height: auto;
    }
</style>

<script
  is:inline
  src="https://unpkg.com/pdfjs-dist@5.4.624/build/pdf.min.mjs"
  type="module"></script>

<script>
    const certificate = document.getElementById("certificate")! as HTMLCanvasElement;

    // @ts-expect-error
    pdfjsLib.GlobalWorkerOptions.workerSrc = "https://unpkg.com/pdfjs-dist@5.4.624/build/pdf.worker.min.mjs";
    const certificateUrl = certificate!.classList.value;

    async function loadCertificate() {
        // @ts-expect-error
        let doc = await pdfjsLib.getDocument(certificateUrl).promise;
        doc.getPage(1)
            // @ts-expect-error
            .then(function (page) {
    			const viewport = page.getViewport({ scale: 1 });

    			certificate.width = viewport.width;
    			certificate.height = viewport.height - 5;
                const ctx = certificate.getContext('2d');

    			const renderContext = {
    				canvasContext: ctx,
    				viewport: viewport,
    			};

    			page.render(renderContext);
    		});
    }

    loadCertificate();
</script>
