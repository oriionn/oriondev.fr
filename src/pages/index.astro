---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home" description={true}></Layout>

<script>
    const validLanguages = ["fr", "en"];
    let language = navigator.language === "fr" ? "fr":"en";
    let storedLanguage = localStorage.getItem("language")
    if (storedLanguage != null) language = storedLanguage;

    if (!validLanguages.includes(language)) language = "en";
    localStorage.setItem("language", language);
    window.location.href = `/${language}`
</script>
