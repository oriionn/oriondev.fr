---
import Navbar from "../../components/Navbar.astro";
import Profile from "../../components/Profile.astro";
import Bio from "../../components/Bio.astro";
import GitHub from '../../components/GitHub.astro';
import Work from "../../components/Work.astro";
import Projects from "../../components/Projects.astro";
import Events from "../../components/Events.astro";
import Friends from "../../components/Friends.astro";
import Footer from "../../components/Footer.astro";

import Layout from '../../layouts/Layout.astro';
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { getLocale } from "../../utils/translation";

export const prerender = true;

export const getStaticPaths = (async () => {
	const translations = await getCollection("translations");

	return translations.map((translation: { id: string }) => ({
        params: { lang: translation.id },
    }));
}) satisfies GetStaticPaths;

// @ts-expect-error
const { translation, lang } = await getLocale(Astro);
---

<Layout title={translation.tabs.home} description={true}>
    <div id="userlang" class={lang}></div>
    <Navbar />
    <Profile />
    <Bio />
    <GitHub />
    <Work />
    <Projects />
    <Events />
    <Friends />
    <Footer />
</Layout>

<script>
    const langEl = document.getElementById("userlang");
    localStorage.setItem("language", langEl?.classList.toString() ?? "en");
</script>
