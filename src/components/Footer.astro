---
import { getTranslation } from "../utils/translation";

const { lang } = Astro.params ?? { lang: "en" };
const translation = await getTranslation(lang!);
---

<footer>
    <p>{translation.footer.designed} <b>Orion</b></p>
    <p>&copy; 2026. {translation.footer.copyright}</p>

    <span>🏳️‍🌈</span>
</footer>

<style>
    footer {
        padding: 50px;

        display: flex;
        flex-direction: column;
        align-items: center;
    }

    p, b {
        color: var(--secondary-foreground);
    }

    span {
        margin-top: 10px;
    }

    b {
        font-weight: 476;
    }

    @media (max-width: 420px) {
        footer {
            width: 100%;
            padding: 50px 0;
        }
    }
</style>
