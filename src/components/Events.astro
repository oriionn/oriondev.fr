---
import { getCollection } from "astro:content";
import { getLocale } from "../utils/translation";
import { dateFormatter } from "../utils/formatter";

const { translation, lang } = await getLocale(Astro);

let events = await getCollection("events");
// @ts-expect-error
events.sort((a, b) => (new Date(b.data.date) - new Date(a.data.date)));
const formatter = Intl.DateTimeFormat(translation.home.intl, {
    timeZone: "Europe/Paris",
    month: "long",
    year: "numeric",
});
---

<section id="events">
    <h2>{translation.events.title}</h2>
    <div class="events">
        {events.map(event =>
            <div class="event">
                <div class="left">
                    <h3>{event.data.title}</h3>
                    <span class="mobile_date">{formatter.format(event.data.date).toLowerCase()}</span>
                    <p>{event.data.description[lang]}</p>
                    <ul>
                        {event.data.certificate !== null ?
                            <li>
                                <a href={`/certificate/${event.data.certificate}`}>{translation.events.certificate}</a>
                            </li>:null
                        }
                        {event.data.tags.map(tag =>
                            <li>{tag}</li>
                        )}
                    </ul>
                </div>
                <div class="right">
                    <span>{formatter.format(event.data.date).toLowerCase()}</span>
                </div>
            </div>
        )}
    </div>
</section>

<style>
    .events {
        display: flex;
        flex-direction: column;
    }

    .event {
        width: 100%;
        padding: 15px;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    p {
        width: 75%;
    }

    span, p {
        color: var(--secondary-foreground);
    }

    ul {
        display: flex;
        flex-direction: row;

        gap: 10px;
        margin-top: 10px;
    }

    li {
        list-style-type: none;
        border-radius: 2px;
        padding: 2px 4px;
    }

    li:not(:has(a)) {
        color: var(--tertiary-foreground);
        border: 1px dashed var(--tertiary-foreground);
    }

    li:has(a) {
        background: var(--secondary-background);
        color: var(--primary-foreground);
        border-radius: 5px;
    }

    li a {
        text-decoration: none;
    }

    .right {
        white-space: nowrap;
        flex-shrink: 0;
    }

    .mobile_date {
        display: none;
    }

    @media (max-width: 665px) {
        .right {
            display: none;
        }

        .mobile_date {
            display: inline-block !important;
            margin-bottom: 10px;
            font-size: 14px;
        }

        h3 {
            margin-bottom: -2px;
        }

        p {
            width: 100%;
        }
    }
</style>
