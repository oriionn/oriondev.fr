---
import { Moon, Sun } from "@lucide/astro";
---

<nav>
    <div class="navigation">
        <button id="toggle_theme">
            <Moon size={30} class="moon" />
            <Sun size={30} class="sun" />
        </button>
        <a href="#events">Events</a>
        <span class="separator">/</span>
        <a href="#projects">Projects</a>
        <span class="separator">/</span>
        <a href="#work">Work</a>
        <span class="separator">/</span>
        <a href="#home">Home</a>
    </div>
</nav>

<style>
    nav {
        position: fixed;
        top: 0;
        left: 0;

        width: 100dvw;
        display: flex;
        justify-content: center;
        border-bottom: 1px var(--secondary-background) solid;

        transition: backdrop-filter .5s;
        backdrop-filter: blur(6px) opacity(0);
    }

    nav.blurred {
        backdrop-filter: blur(6px) opacity(1);
    }

    .navigation {
        width: 50%;
        padding: 20px 0;

        display: flex;
        gap: 10px;
        flex-direction: row-reverse;
        align-items: center;
    }

    .separator {
        color: var(--secondary-foreground);
    }

    #toggle_theme {
        margin-left: 10px;
        background: none;
        border: none;
        cursor: pointer;
    }

    #toggle_theme svg {
        stroke: var(--primary-foreground);
    }

    a {
        color: var(--primary-foreground);
        text-decoration: none;
    }

    a, .separator {
        font-size: 20px;
    }

    body.dark .moon {
        display: none;
    }

    body.dark .sun {
        display: block;
    }

    body:not(.dark) .moon {
        display: block;
    }

    body:not(.dark) .sun {
        display: none;
    }
</style>

<script>
    const nav = document.querySelector("nav");
    const toggleThemeBtn = document.getElementById("toggle_theme");

    document.addEventListener("scroll", (e) => {
        if (document.body.scrollTop > 0 || document.documentElement.scrollTop > 0) {
            nav?.classList.add("blurred");
        } else {
            nav?.classList.remove("blurred");
        }
    });

    window.addEventListener("load", () => {
        let storage = localStorage.getItem("theme");

        if (!storage) {
            let defaultDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
            storage = (defaultDark && defaultDark.matches) ? "dark":"light";
            localStorage.setItem("theme", storage);
        }

        if (storage === "dark") document.body.classList.add("dark");
    });

    toggleThemeBtn?.addEventListener("click", () => {
        document.body.classList.toggle("dark");
        localStorage.setItem("theme", document.body.classList.contains("dark") ? "dark":"light");
    });
</script>
