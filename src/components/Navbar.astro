---
import { Moon } from "@lucide/astro";
---

<nav>
    <div class="navigation">
        <button id="toggle_theme"><Moon size={30} /></button>
        <a href="#projects">Events</a>
        <span class="separator">/</span>
        <a href="#projects">Projects</a>
        <span class="separator">/</span>
        <a href="#work">Work</a>
        <span class="separator">/</span>
        <a href="#home">Home</a>
    </div>
</nav>

<style>
    nav {
        position: fixed;
        top: 0;
        left: 0;

        width: 100dvw;
        display: flex;
        justify-content: center;
        border-bottom: 1px var(--secondary-background) solid;
    }

    .navigation {
        width: 50%;
        padding: 20px 0;
        font-size: 20px;

        display: flex;
        gap: 10px;
        flex-direction: row-reverse;
        align-items: center;
    }

    .separator {
        color: var(--secondary-foreground);
    }

    #toggle_theme {
        margin-left: 10px;
        background: none;
        border: none;
        cursor: pointer;
    }

    #toggle_theme svg {
        stroke: var(--primary-foreground);
    }

    a {
        color: var(--primary-foreground);
        text-decoration: none;
    }
</style>
