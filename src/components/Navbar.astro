---
import { Moon, Sun, Menu, X } from "@lucide/astro";
import { getTranslation } from "../utils/translation";

const { lang } = Astro.params ?? { lang: "en" };
const translation = await getTranslation(lang!);
---

<nav>
    <div class="navigation">
        <button id="toggle_theme">
            <Moon size={30} class="moon" />
            <Sun size={30} class="sun" />
        </button>
        <a href="#events" onclick="onLinkClick()">{translation.events.title}</a>
        <span class="separator">/</span>
        <a href="#projects" onclick="onLinkClick()">{translation.projects.title}</a>
        <span class="separator">/</span>
        <a href="#work" onclick="onLinkClick()">{translation.work.title}</a>
        <span class="separator">/</span>
        <a href="#home" onclick="onLinkClick()">{translation.home.title}</a>

        <ul>
            <li class={lang === "fr" ? "active":""}>
                <a href="/fr">FR</a>
            </li>
            <li class={lang === "en" ? "active":""}>
                <a href="/en">EN</a>
            </li>
        </ul>

        <button id="menu" class="menu">
            <Menu size={30} class="menu open" />
            <X size={48} class="close" />
        </button>
    </div>
</nav>

<style>
    nav {
        position: fixed;
        top: 0;
        left: 0;

        width: 100dvw;
        display: flex;
        justify-content: center;
        border-bottom: 1px var(--secondary-background) solid;

        transition: backdrop-filter .5s;
        backdrop-filter: blur(6px) opacity(0);
    }

    nav.blurred, nav.opened {
        backdrop-filter: blur(6px) opacity(1);
    }

    .navigation {
        width: 50%;
        padding: 20px 0;

        display: flex;
        gap: 10px;
        flex-direction: row-reverse;
        align-items: center;
    }

    .separator {
        color: var(--secondary-foreground);
    }

    #toggle_theme {
        margin-left: 10px;
        background: none;
        border: none;
        cursor: pointer;
    }

    #toggle_theme svg {
        stroke: var(--primary-foreground);
    }

    a {
        color: var(--primary-foreground);
        text-decoration: none;
    }

    a, .separator {
        font-size: 20px;
    }

    body.dark .moon {
        display: none;
    }

    body.dark .sun {
        display: block;
    }

    body:not(.dark) .moon {
        display: block;
    }

    body:not(.dark) .sun {
        display: none;
    }

    @media (max-width: 1350px) {
        .navigation {
            width: 75%;
        }
    }

    @media (max-width: 600px) {
        .navigation {
            width: calc(100% - 20px);
        }
    }

    .menu {
        display: none;
    }

    ul {
        margin-right: auto;
        display: flex;
        flex-direction: row;

        padding: 7px;
        border-radius: 50px;
    }

    li {
        list-style-type: none;

        padding: 5px 10px;
        border-radius: 50px;
    }

    li.active {
        background: var(--primary-foreground);
    }

    li a {
        font-size: 16px;
    }

    li.active a {
        color: var(--secondary-background);
    }

    @media (max-width: 750px) {
        nav:not(.opened) .navigation *:not(.menu):not(#toggle_theme):not(#toggle_theme *) {
            display: none;
        }

        nav:not(.opened) .navigation {
            flex-direction: row;
            justify-content: space-between;
            gap: 10px;
        }

        .menu {
            display: flex;
        }

        #menu {
            background: none;
            border: none;
            outline: none;
            cursor: pointer;
        }

        nav.opened .menu .open, nav.opened #toggle_theme {
            display: none;
        }

        nav.opened {
            width: 100%;
            height: 100%;
            z-index: 50;
        }

        nav.opened .close {
            position: absolute;
            top: 25px;
            right: 35px;
        }

        nav.opened .navigation {
            flex-direction: column-reverse;
            align-items: center;
            justify-content: center;

            gap: 20px;
        }

        nav.opened a {
            font-size: 48px;
            font-weight: 450;
        }

        nav.opened .separator {
            display: none;
        }
    }
</style>

<script>
    const nav = document.querySelector("nav");
    const toggleThemeBtn = document.getElementById("toggle_theme");
    const menu = document.getElementById("menu");

    function updateBlur() {
        if (document.body.scrollTop > 0 || document.documentElement.scrollTop > 0) {
            nav?.classList.add("blurred");
        } else {
            nav?.classList.remove("blurred");
        }
    }

    document.addEventListener("scroll", updateBlur);

    window.addEventListener("load", () => {
        updateBlur();

        let storage = localStorage.getItem("theme");

        if (!storage) {
            let defaultDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
            storage = (defaultDark && defaultDark.matches) ? "dark":"light";
            localStorage.setItem("theme", storage);
        }

        if (storage === "dark") document.body.classList.add("dark");
    });

    toggleThemeBtn?.addEventListener("click", () => {
        document.body.classList.toggle("dark");
        localStorage.setItem("theme", document.body.classList.contains("dark") ? "dark":"light");
    });

    menu?.addEventListener("click", () => {
        nav?.classList.toggle("opened");
    });

    function onLinkClick() {
        if (nav?.classList.contains("opened")) nav?.classList.remove("opened");
    }

    document.querySelectorAll("a").forEach(el => {
        el.addEventListener("click", onLinkClick);
    });

</script>
