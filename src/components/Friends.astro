---
import { getCollection } from "astro:content";
import { getLocale } from "../utils/translation";

const { translation } = await getLocale(Astro);
const friends = await getCollection("friends");
---

<section>
    <h2>{translation.friends.title}</h2>
    <div class="friends">
        {friends.map(friend =>
            <a href={friend.data.url} class="friend">
                <img src={friend.data.image} alt={friend.data.name}></img>
                <h3>{friend.data.name}</h3>
            </a>
        )}
    </div>
</section>

<style>
    .friends {
        display: flex;
        flex-direction: row;
        overflow-x: scroll;
    }

    .friend {
        padding: 15px;
        text-align: center;
    }

    img {
        width: 150px;
        height: 150px;
        border-radius: 10px;
    }

    a:not(:hover) {
        text-decoration: none;
    }
</style>
