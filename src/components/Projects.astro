---
import { Github, SquareArrowOutUpRight } from "@lucide/astro";
import { getLocale } from "../utils/translation";
import { getCollection } from "astro:content";

const { translation, lang } = await getLocale(Astro);
let projects = await getCollection("projects");
---

<section id="projects">
    <h2>{translation.projects.title}</h2>
    <div class="projects">
        {projects.map((project) => (
            <div class="project">
                <div class="left">
                    <h3>{project.data[lang].title}</h3>
                    <p>{project.data[lang].description}</p>
                    <ul>
                        {project.data.stacks.map((stack) => {
                            <li>{stack}</li>
                        })}
                    </ul>
                </div>

                <div class="right">
                    <ul>
                        {project.data.website ? <li>
                            <a href={project.data.website} target="_blank"><SquareArrowOutUpRight /></a>
                        </li>:null}
                        {project.data.github ? <li>
                            <a href={project.data.github} target="_blank"><Github /></a>
                        </li>:null}
                    </ul>
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    .projects {
        display: flex;
        flex-direction: column;
    }

    .project {
        width: 100%;
        padding: 15px;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }

    p {
        color: var(--secondary-foreground);
        width: 75%;
    }

    .left ul {
        margin-top: 10px;
        list-style-type: none;

        display: flex;
        flex-direction: row;
        gap: 10px;
    }

    .left ul li {
        color: var(--tertiary-foreground);
        border: 1px dashed var(--tertiary-foreground);
        border-radius: 2px;
        padding: 2px 4px;

        font-size: 13px;
        font-weight: 301;
    }

    .right ul, .mobile_links {
        list-style-type: none;

        display: flex;
        flex-direction: row-reverse;
        gap: 10px;
    }

    .right a, .mobile_links a {
        padding: 7px;
        background: var(--secondary-background);
        border-radius: 5px;

        display: flex;
    }

    .right a * {
        margin: 0;
    }

    .right a svg {
        stroke: var(--primary-foreground);
    }

    @media (max-width: 665px) {
        .right svg {
            width: 16px;
            height: 16px;
        }

        .right a {
            padding: 5px;
        }
    }
</style>
