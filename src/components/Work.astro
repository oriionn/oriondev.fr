---
import { getCollection } from "astro:content";
import { getLocale } from "../utils/translation";

const { lang, translation } = await getLocale(Astro);

let works = await getCollection("works")
// @ts-expect-error
works.sort((a, b) => (new Date(b.data.start) - new Date(a.data.start)));

const dateFormatter = new Intl.DateTimeFormat(translation.home.intl, {
    timeZone: "Europe/Paris",
    month: "short",
    year: "numeric",
});

const formatDate = (start: Date, end: Date | null) =>
    `${dateFormatter.format(start)} - ${end === null ? translation.today:dateFormatter.format(end)}`.toLowerCase()
---

<section id="work">
    <h2>{translation.work.title}</h2>
    <div class="works">
        {works.map((work) => (
            <div class="work">
                <div class="left">
                    <h3>{work.data[lang].title}</h3>
                    <span class="mobile_date">oct 2025 - today</span>
                    <p>{work.data[lang].subtitle}</p>
                </div>
                <div class="right">
                    <span>{formatDate(work.data.start, work.data.end)}</span>
                </div>
            </div>
        ))}
    </div>
</section>

<style>
    h2 {
        margin-top: 10px;
    }

    .works {
        display: flex;
        flex-direction: column;
    }

    .work {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
    }

    p, span {
        color: var(--secondary-foreground);
    }

    .mobile_date {
        display: none;
    }

    @media (max-width: 665px) {
        .right {
            display: none;
        }

        .mobile_date {
            display: inline-block !important;
        }



        p {
            width: 100%;
        }
    }
</style>
