---
import { GithubCalendar } from "./Calendar";
import "../styles/calendar.css";
import { getLocale } from "../utils/translation";

const { translation } = await getLocale(Astro);
---

<section class="github">
    <GithubCalendar client:load months={translation.github.months} />
</section>

<style>
    :global(.react-activity-calendar), :global(.react-activity-calendar > div) {
        width: 100% !important;
    }

    :global(.react-activity-calendar svg) {
        width: 100% !important;
        height: 100% !important;
    }

    @media (max-width: 900px) {
        section {
            display: none;
        }
    }
</style>
