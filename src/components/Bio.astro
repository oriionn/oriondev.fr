---
import { Github, Twitter } from "@lucide/astro";
import { getCollection, render } from "astro:content";
import { getLocale } from "../utils/translation";

const { lang } = await getLocale(Astro);
const bios = await getCollection("bio");
let bio = bios.filter((bio: { id: string }) => bio.id === lang)[0];
const { Content } = await render(bio);
---

<section class="bio">
    <Content />
    <div class="socials">
        <a href="https://github.com/oriionn" target="_blank">
            <Github />
        </a>
        <a href="https://x.com/orion_offi" target="_blank">
            <Twitter />
        </a>
    </div>
</section>

<style>
    :global(strong) {
        font-weight: 476 !important;
    }

    :global(.bio p) {
        margin-top: 0;
        margin-bottom: 10px;
    }

    .socials {
        display: flex;
        flex-direction: row;
        gap: 10px;
        margin-top: 15px;
    }

    .socials a {
        background: var(--secondary-background);
        width: 36px;
        height: 36px;
        border-radius: 5px;

        display: flex;
        justify-content: center;
        align-items: center;
    }

    svg {
        stroke: var(--primary-foreground);
    }
</style>
