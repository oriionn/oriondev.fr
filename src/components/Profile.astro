---
import Avatar from "../assets/avatar.jpg";
import { getTranslation } from "../utils/translation";

const { lang } = Astro.params ?? { lang: "en" };
const translation = await getTranslation(lang!);
---

<section class="profile" id="home">
    <img src={Avatar.src} alt="Orion's avatar" />
    <div class="presentation">
        <h1>Orion</h1>
        <div class="indent">
            <span>{translation.subtitle}</span>
            <span class="datetime">
                <span id="time"></span>
                •
                <span id="date" data-intl={translation.home.intl}></span>
            </span>
        </div>
    </div>
</section>

<style>
    img {
        width: 120px;
        height: auto;
        border-radius: 10px;
    }

    section {
        margin-top: 84px;
        padding-top: 20px;
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .presentation {
        display: flex;
        flex-direction: column;
        margin-left: 20px;
    }

    h1 {
        margin: 0;
        font-weight: 600;
        font-size: 32px !important;
    }

    .indent {
        margin-left: 20px;
        display: flex;
        flex-direction: column;
    }

    .indent span {
        color: var(--secondary-foreground);
    }

    #time {
        font-variant-numeric: tabular-nums;
    }

    @media (max-width: 575px) {
        img {
            width: 100px;
            height: 100px;
        }

        .datetime {
            display: none;
        }
    }

    @media (max-width: 505px) {
        .indent span {
            font-size: 15px;
        }
    }
</style>

<script>
    const dateEl = document.getElementById("date");
    const timeEl = document.getElementById("time");
    const intl = dateEl?.getAttribute("data-intl")!;

    const timeFormatter = new Intl.DateTimeFormat([], {
        timeZone: "Europe/Paris",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });

    const dateFormatter = new Intl.DateTimeFormat(intl, {
        timeZone: "Europe/Paris",
        weekday: "short",
        month: "short",
        year: "numeric",
    });

    const formatDate = (date: Date) => {
        let raw = dateFormatter.format(date);
        const s: string[] = raw.split(" ");
        let formatted = `${s[2]}${intl === "en" ? ",":""} ${s[0]} ${s[1]}`;
        return formatted;
    }

    function refreshDateTime() {
        let date = new Date();
        let d = formatDate(date);
        let t = timeFormatter.format();

        dateEl!.textContent = d;
        timeEl!.textContent = t;
    }

    refreshDateTime();
    setInterval(refreshDateTime, 1000);
</script>
