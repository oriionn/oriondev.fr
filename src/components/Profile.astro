---
import Avatar from "../assets/avatar.jpg"
---

<section class="profile">
    <img src={Avatar.src} alt="Orion's avatar" />
    <div class="presentation">
        <h1>Orion</h1>
        <div class="indent">
            <span>Developer & High School Student</span>
            <span>
                <span id="time"></span>
                •
                <span id="date"></span>
            </span>
        </div>
    </div>
</section>

<style>
    img {
        width: 120px;
        height: auto;
        border-radius: 10px;
    }

    section {
        margin-top: 75.75px;
        padding-top: 20px;
        display: flex;
        flex-direction: row;
        align-items: center;
    }

    .presentation {
        display: flex;
        flex-direction: column;
        margin-left: 20px;
    }

    h1 {
        margin: 0;
        font-weight: 600;
        font-size: 32px !important;
    }

    .indent {
        margin-left: 20px;
        display: flex;
        flex-direction: column;
        color: var(--secondary-foreground)
    }

    #time {
        font-variant-numeric: tabular-nums;
    }
</style>

<script>
    const dateEl = document.getElementById("date");
    const timeEl = document.getElementById("time");

    const timeFormatter = new Intl.DateTimeFormat([], {
        timeZone: "Europe/Paris",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit"
    });

    const dateFormatter = new Intl.DateTimeFormat("en-US", {
        timeZone: "Europe/Paris",
        weekday: "short",
        month: "short",
        year: "numeric",
    });

    const formatDate = (date: Date) => {
        let raw = dateFormatter.format(date);
        const s: string[] = raw.split(" ");
        let formatted = `${s[2]}, ${s[0]} ${s[1]}`;
        return formatted;
    }

    function refreshDateTime() {
        let date = new Date();
        let d = formatDate(date);
        let t = timeFormatter.format();

        dateEl!.textContent = d;
        timeEl!.textContent = t;
    }

    refreshDateTime();
    setInterval(refreshDateTime, 1000);
</script>
