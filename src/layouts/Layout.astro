---
import { getEntry } from "astro:content";
import removeMd from "remove-markdown";
import { getLocale } from "../utils/translation";

interface Props {
    title: string;
    description?: boolean;
}

const { title, description = false } = Astro.props;

let desc = "";
if (description) {
    const { translation, lang } = await getLocale(Astro);
    const bioRaw = await getEntry("bio", lang);
    const bio = removeMd(bioRaw!.body!);

    desc = bio.split(".")[0] + ".";
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Orion • {title}</title>

		<meta property="og:title" content={`Orion • ${title}`} />
		{description ? (
            <meta property="og:description" content={desc} />
		):null}

        <meta property="og:image" content="/avatar.jpg" />
        <meta property="og:image:width" content="256" />
        <meta property="og:image:height" content="256" />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="fr_FR" />

        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={`Orion • ${title}`} />
        {description ? (
            <meta name="twitter:description" content={desc} />
        ):null}
        <meta name="twitter:image" content="/avatar.jpg" />
	</head>
	<body>
        <div class="content">
            <slot />
        </div>
	</body>
</html>

<style>
    @import url(https://fonts.nerieum.fr/fonts/snpro.css);

    :global(*) {
        margin: 0;
        padding: 0;
        color: var(--primary-foreground);
        font-family: 'SN Pro', sans-serif;
        font-weight: 301;
        font-size: 16px;
    }

    html {
        scroll-padding-top: 85px;
        scroll-behavior: smooth;
    }

	body {
	    --primary-background: #FFFFFF;
		--secondary-background: #F2F2F2;

		--primary-foreground: #000000;
		--secondary-foreground: rgba(0, 0, 0, .6);
		--tertiary-foreground: rgba(18, 18, 18, .6);

	    width: 100dvw;
		height: 100dvh;
		background: var(--primary-background);

		display: flex;
		justify-content: center;
	}

	body.dark {
	    --primary-background: #121212;
		--secondary-background: #242424;

		--primary-foreground: #ffffff;
		--secondary-foreground: rgba(255, 255, 255, .6);
		--tertiary-foreground: rgba(242, 242, 242, .6);
	}

	:global(section) {
	    padding: 15px;
		padding-top: 0;
	}

	.content {
	    width: 50%;
	}

	:global(h2) {
	    font-size: 32px;
		font-weight: 635;
	}

	:global(h3) {
        font-weight: 476;
        font-size: 22px;
        margin-bottom: 2px;
    }

    @media (max-width: 1350px) {
        .content {
            width: 75%;
        }
    }

    @media (max-width: 600px) {
        .content {
            width: calc(100% - 40px);
        }
    }
</style>
